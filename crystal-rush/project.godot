; Engine configuration file.
; Crystal Rush — lane runner with an army for Android (Godot 4.7).

config_version=5

[application]

config/name="Crystal Rush"
config/name_localized={
"en": "Crystal Rush",
"uk": "Кришталевий Ривок"
}
config/description="Pick your lane, grow your army, storm the Red Horde's fortress."
config/version="2.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.2, 0.45, 0.75, 1)
boot_splash/show_image=false

[autoload]

Save="*res://scripts/autoload/save.gd"
Meta="*res://scripts/autoload/meta.gd"
Loc="*res://scripts/autoload/loc.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.45, 0.7, 0.95, 1)
