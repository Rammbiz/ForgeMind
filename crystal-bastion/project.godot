; Engine configuration file.
; Crystal Bastion — 3D tower defense for Android (Godot 4.7).

config_version=5

[application]

config/name="Crystal Bastion"
config/name_localized={
"en": "Crystal Bastion",
"uk": "Кришталевий Бастіон"
}
config/description="Stylized 3D tower defense for Android."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0627451, 0.0784314, 0.137255, 1)
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
Save="*res://scripts/autoload/save_data.gd"
Loc="*res://scripts/autoload/loc.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.0627451, 0.0784314, 0.137255, 1)
